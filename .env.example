APP_NAME="Revamp Template"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/revamp

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=revamp
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Site branding — update these when revamping a client website
SITE_NAME="Your Website"
SITE_SHORT_NAME="YW"
SITE_TAGLINE="Your tagline goes here"
SITE_DESCRIPTION="A brief description of your website."
SITE_SOURCE_URL=""
SITE_EMAIL=hello@example.com
SITE_PHONE="(000) 000-0000"
SITE_PHONE_HREF=0000000000
SITE_FOOTER_TEXT="Add a short description of your business here."

# Theme colors
SITE_COLOR_PRIMARY="#3B82F6"
SITE_COLOR_SECONDARY="#06B6D4"
SITE_COLOR_ACCENT="#8B5CF6"
SITE_COLOR_BG="#0F172A"

# Social links (leave empty to hide)
SITE_FACEBOOK=
SITE_INSTAGRAM=
SITE_TWITTER=
SITE_LINKEDIN=
SITE_YOUTUBE=
SITE_SPOTIFY=
SITE_TIKTOK=
